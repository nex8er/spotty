{
    // Основной вход в сборку для VS Code. Задачи не используют CMake Presets: весь
    // необходимый вариант виден в названии и собирается в свой каталог.
    "version": "2.0.0",
    "tasks": [
        {
            "label": "$(gear) cfg debug",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build/debug-dynamic",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DSPOTTY_BUILD_TESTS=ON",
                "-DSPOTTY_STATIC_PLUGINS=OFF"
            ],
            "windows": {
                "options": {
                    "env": {
                        "CMAKE_PREFIX_PATH": "${config:spotty.qtRoot};${env:CMAKE_PREFIX_PATH}",
                        "CXX": "${config:spotty.mingwCompiler}",
                        "PATH": "${config:spotty.qtRoot}/bin;${config:spotty.mingwBin};${env:PATH}"
                    }
                }
            },
            "osx": {
                "options": {
                    "env": {
                        "CMAKE_PREFIX_PATH": "${config:spotty.macosQtPrefix}:${env:CMAKE_PREFIX_PATH}"
                    }
                }
            },
            "hide": true,
            "problemMatcher": [],
            "detail": "Внутренняя настройка для отладки и тестов"
        },
        {
            "label": "$(gear) cfg release",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build/release-dynamic",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DSPOTTY_STATIC_PLUGINS=OFF"
            ],
            "windows": {
                "options": {
                    "env": {
                        "CMAKE_PREFIX_PATH": "${config:spotty.qtRoot};${env:CMAKE_PREFIX_PATH}",
                        "CXX": "${config:spotty.mingwCompiler}",
                        "PATH": "${config:spotty.qtRoot}/bin;${config:spotty.mingwBin};${env:PATH}"
                    }
                }
            },
            "osx": {
                "options": {
                    "env": {
                        "CMAKE_PREFIX_PATH": "${config:spotty.macosQtPrefix}:${env:CMAKE_PREFIX_PATH}"
                    }
                }
            },
            "hide": true,
            "problemMatcher": [],
            "detail": "Внутренняя настройка релизной сборки с загружаемыми плагинами"
        },
        {
            "label": "$(gear) cfg static",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build/release-static",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DSPOTTY_STATIC_PLUGINS=ON"
            ],
            "windows": {
                "options": {
                    "env": {
                        "CMAKE_PREFIX_PATH": "${config:spotty.qtRoot};${env:CMAKE_PREFIX_PATH}",
                        "CXX": "${config:spotty.mingwCompiler}",
                        "PATH": "${config:spotty.qtRoot}/bin;${config:spotty.mingwBin};${env:PATH}"
                    }
                }
            },
            "osx": {
                "options": {
                    "env": {
                        "CMAKE_PREFIX_PATH": "${config:spotty.macosQtPrefix}:${env:CMAKE_PREFIX_PATH}"
                    }
                }
            },
            "hide": true,
            "problemMatcher": [],
            "detail": "Внутренняя настройка релизной сборки со вкомпилированными плагинами"
        },
        {
            "label": "$(gear) cfg pack dyn",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build/package-dynamic",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DSPOTTY_STATIC_PLUGINS=OFF"
            ],
            "windows": {
                "options": {
                    "env": {
                        "CMAKE_PREFIX_PATH": "${config:spotty.qtRoot};${env:CMAKE_PREFIX_PATH}",
                        "CXX": "${config:spotty.mingwCompiler}",
                        "PATH": "${config:spotty.qtRoot}/bin;${config:spotty.mingwBin};${env:PATH}"
                    }
                }
            },
            "osx": {
                "options": {
                    "env": {
                        "CMAKE_PREFIX_PATH": "${config:spotty.macosQtPrefix}:${env:CMAKE_PREFIX_PATH}"
                    }
                }
            },
            "hide": true,
            "problemMatcher": [],
            "detail": "Внутренняя настройка пакета с загружаемыми плагинами"
        },
        {
            "label": "$(gear) cfg pack static",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build/package-static",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Release",
                "-DSPOTTY_STATIC_PLUGINS=ON"
            ],
            "windows": {
                "options": {
                    "env": {
                        "CMAKE_PREFIX_PATH": "${config:spotty.qtRoot};${env:CMAKE_PREFIX_PATH}",
                        "CXX": "${config:spotty.mingwCompiler}",
                        "PATH": "${config:spotty.qtRoot}/bin;${config:spotty.mingwBin};${env:PATH}"
                    }
                }
            },
            "osx": {
                "options": {
                    "env": {
                        "CMAKE_PREFIX_PATH": "${config:spotty.macosQtPrefix}:${env:CMAKE_PREFIX_PATH}"
                    }
                }
            },
            "hide": true,
            "problemMatcher": [],
            "detail": "Внутренняя настройка пакета со вкомпилированными плагинами"
        },
        {
            "label": "$(gear) cfg coverage",
            "type": "process",
            "command": "cmake",
            "args": [
                "-S", "${workspaceFolder}",
                "-B", "${workspaceFolder}/build/coverage",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DSPOTTY_BUILD_TESTS=ON",
                "-DSPOTTY_ENABLE_COVERAGE=ON"
            ],
            "windows": {
                "options": {
                    "env": {
                        "CMAKE_PREFIX_PATH": "${config:spotty.qtRoot};${env:CMAKE_PREFIX_PATH}",
                        "CXX": "${config:spotty.mingwCompiler}",
                        "PATH": "${config:spotty.qtRoot}/bin;${config:spotty.mingwBin};${env:PATH}"
                    }
                }
            },
            "osx": {
                "options": {
                    "env": {
                        "CMAKE_PREFIX_PATH": "${config:spotty.macosQtPrefix}:${env:CMAKE_PREFIX_PATH}"
                    }
                }
            },
            "hide": true,
            "problemMatcher": [],
            "detail": "Внутренняя настройка тестов с покрытием"
        },
        {
            "label": "$(tools) Debug",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build/debug-dynamic"],
            "dependsOn": "$(gear) cfg debug",
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"],
            "options": {
                "statusbar": {"label": "$(tools) Debug"}
            },
            "detail": "Отладочная сборка и тесты с загружаемыми плагинами"
        },
        {
            "label": "$(tools) Release",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build/release-dynamic"],
            "dependsOn": "$(gear) cfg release",
            "problemMatcher": ["$gcc"],
            "options": {
                "statusbar": {"hide": true}
            },
            "detail": "Релизная сборка с загружаемыми плагинами"
        },
        {
            "label": "$(layers) Static",
            "type": "process",
            "command": "cmake",
            "args": ["--build", "${workspaceFolder}/build/release-static"],
            "dependsOn": "$(gear) cfg static",
            "problemMatcher": ["$gcc"],
            "options": {
                "statusbar": {"label": "$(layers) Static"}
            },
            "detail": "Релизная сборка со вкомпилированными плагинами"
        },
        {
            "label": "$(beaker) Test",
            "type": "process",
            "command": "ctest",
            "args": [
                "--test-dir", "${workspaceFolder}/build/debug-dynamic",
                "--output-on-failure"
            ],
            "dependsOn": "$(tools) Debug",
            "group": {"kind": "test", "isDefault": true},
            "problemMatcher": [],
            "options": {
                "env": {"QT_QPA_PLATFORM": "offscreen"},
                "statusbar": {"label": "$(beaker) Test"}
            },
            "windows": {
                "options": {
                    "env": {
                        "QT_QPA_PLATFORM": "offscreen",
                        "PATH": "${config:spotty.qtRoot}/bin;${config:spotty.mingwBin};${env:PATH}"
                    }
                }
            },
            "detail": "Прогнать все тесты"
        },
        {
            "label": "$(package) Pack dyn",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build/package-dynamic",
                "--target", "spotty-package"
            ],
            "dependsOn": "$(gear) cfg pack dyn",
            "problemMatcher": ["$gcc"],
            "options": {
                "statusbar": {"label": "$(package) Pack dyn"}
            },
            "detail": "Пакет с загружаемыми модулями плагинов"
        },
        {
            "label": "$(package) Pack static",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build/package-static",
                "--target", "spotty-package"
            ],
            "dependsOn": "$(gear) cfg pack static",
            "problemMatcher": ["$gcc"],
            "options": {
                "statusbar": {"label": "$(package) Pack static"}
            },
            "detail": "Пакет со вкомпилированными плагинами"
        },
        {
            "label": "$(graph) Coverage",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build/coverage",
                "--target", "coverage"
            ],
            "dependsOn": "$(gear) cfg coverage",
            "problemMatcher": [],
            "options": {
                "statusbar": {"hide": true}
            },
            "windows": {
                "options": {
                    "env": {
                        "PATH": "${config:spotty.qtRoot}/bin;${config:spotty.mingwBin};${env:PATH}"
                    },
                    "statusbar": {"hide": true}
                }
            },
            "detail": "Прогнать тесты и создать отчёт покрытия"
        },
        {
            "label": "$(globe) i18n update",
            "type": "process",
            "command": "cmake",
            "args": [
                "--build", "${workspaceFolder}/build/debug-dynamic",
                "--target", "update_translations"
            ],
            "dependsOn": "$(gear) cfg debug",
            "hide": true,
            "problemMatcher": [],
            "detail": "Обновить исходные файлы переводов"
        },
        {
            "label": "$(globe) i18n",
            "type": "process",
            "command": "python3",
            "args": ["${workspaceFolder}/tools/fill_ru_translations.py"],
            "windows": {
                "command": "python"
            },
            "dependsOn": "$(globe) i18n update",
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "options": {
                "statusbar": {"hide": true}
            },
            "detail": "lupdate и заполнение словаря переводов"
        }
    ]
}
