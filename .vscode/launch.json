{
    // Профили отладки Spotty.
    //
    // Используется cppdbg из расширения ms-vscode.cpptools: оно уже установлено, а
    // lldb-mi поставляется вместе с ним. Если предпочитаете CodeLLDB, тип "cppdbg"
    // меняется на "lldb", а поля MIMode и setupCommands становятся ненужными.
    //
    // Все профили собирают отладочную конфигурацию перед запуском, поэтому запускается
    // всегда то, что сейчас в исходниках.
    "version": "0.3.0",
    "configurations": [
        {
            "name": "Spotty: отладка",
            "type": "cppdbg",
            "request": "launch",
            // На macOS исполняемый файл лежит внутри бандла. Запускать нужно именно его,
            // а не сам бандл: плагины ищутся относительно каталога с исполняемым файлом.
            "program": "${workspaceFolder}/build-debug/spotty.app/Contents/MacOS/spotty",
            "linux": {
                "program": "${workspaceFolder}/build-debug/spotty"
            },
            "windows": {
                "program": "${workspaceFolder}/build-debug/spotty.exe"
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "QT_LOGGING_RULES",
                    "value": "spotty.*=true"
                }
            ],
            "MIMode": "lldb",
            "preLaunchTask": "build",
            "setupCommands": [
                {
                    "description": "Красивый вывод контейнеров",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Spotty: без журнала",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/spotty.app/Contents/MacOS/spotty",
            "linux": {
                "program": "${workspaceFolder}/build-debug/spotty"
            },
            "windows": {
                "program": "${workspaceFolder}/build-debug/spotty.exe"
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            // Без категорий журналирования: когда отлаживаешь отрисовку или раскладку,
            // поток сообщений о плагинах и реестре только мешает.
            "environment": [],
            "MIMode": "lldb",
            "preLaunchTask": "build"
        },
        {
            "name": "Spotty: статические плагины",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-static/spotty.app/Contents/MacOS/spotty",
            "linux": {
                "program": "${workspaceFolder}/build-static/spotty"
            },
            "windows": {
                "program": "${workspaceFolder}/build-static/spotty.exe"
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "QT_LOGGING_RULES",
                    "value": "spotty.plugins=true"
                }
            ],
            "MIMode": "lldb",
            // Вторая половина гибридной сборки: здесь плагины вкомпилированы, и путь их
            // загрузки принципиально другой.
            "preLaunchTask": "static"
        },
        {
            "name": "Тесты: все",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/tests/spotty-tests",
            "windows": {
                "program": "${workspaceFolder}/build-debug/tests/spotty-tests.exe"
            },
            "args": [],
            "cwd": "${workspaceFolder}/build-debug",
            "environment": [],
            "MIMode": "lldb",
            "preLaunchTask": "build",
            "setupCommands": [
                {
                    "description": "Красивый вывод контейнеров",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Тесты: выбранные",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build-debug/tests/spotty-tests",
            "windows": {
                "program": "${workspaceFolder}/build-debug/tests/spotty-tests.exe"
            },
            // Образец в стиле gtest: «AnsiParser.*», «*Packetizer*», «Session.SendReaches*».
            "args": ["--gtest_filter=${input:testFilter}"],
            "cwd": "${workspaceFolder}/build-debug",
            "environment": [],
            "MIMode": "lldb",
            "preLaunchTask": "build"
        },
        {
            "name": "Spotty: присоединиться к процессу",
            "type": "cppdbg",
            "request": "attach",
            "program": "${workspaceFolder}/build-debug/spotty.app/Contents/MacOS/spotty",
            "linux": {
                "program": "${workspaceFolder}/build-debug/spotty"
            },
            "windows": {
                "program": "${workspaceFolder}/build-debug/spotty.exe"
            },
            // Нужен, когда программа уже запущена и воспроизводить состояние заново
            // долго: подключиться к живому процессу дешевле, чем повторять сценарий.
            "processId": "${command:pickProcess}",
            "MIMode": "lldb"
        }
    ],
    "inputs": [
        {
            "id": "testFilter",
            "type": "promptString",
            "description": "Образец имён тестов (--gtest_filter)",
            "default": "Session.*"
        }
    ]
}
