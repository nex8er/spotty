{
    // --- Оформление кода по соглашениям проекта ---------------------------------------
    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.detectIndentation": false,
    "editor.rulers": [100],
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.encoding": "utf8",

    // --- Разбор кода ------------------------------------------------------------------
    //
    // База берётся из compile_commands.json отладочной сборки: там настоящие флаги и
    // пути к заголовкам Qt, поэтому переходы по коду и подсказки работают без ручного
    // перечисления каталогов.
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/debug-dynamic/compile_commands.json",
    "C_Cpp.default.cppStandard": "c++20",

    // Пути читают только задачи соответствующей платформы. Версии Qt и MinGW должны
    // совпадать: Qt, собранный MinGW 13.1, нельзя смешивать с найденным в PATH GCC 15.
    "spotty.qtRoot": "C:/Users/nex8er/AppData/Local/Qt/6.11.1/mingw_64",
    "spotty.mingwBin": "C:/Users/nex8er/AppData/Local/Qt/Tools/mingw1310_64/bin",
    "spotty.mingwCompiler": "C:/Users/nex8er/AppData/Local/Qt/Tools/mingw1310_64/bin/g++.exe",
    // На Intel Mac с Homebrew обычно нужен /usr/local. Задачи macOS добавляют этот
    // префикс только на macOS, поэтому Windows-конфигурации он не касается.
    "spotty.macosQtPrefix": "/opt/homebrew",

    // Сборкой управляют задачи из tasks.json: CMake Tools не создаёт второй каталог с
    // неясными флагами при открытии рабочей папки.
    "cmake.configureOnOpen": false,

    // --- Соответствия типов файлов ----------------------------------------------------
    "files.associations": {
        "*.qss": "css",
        "*.ts": "xml",
        "*.qrc": "xml"
    },

    // --- Что прятать ------------------------------------------------------------------
    //
    // Каталоги сборки исключены из поиска: иначе поиск по «TerminalBuffer» находит
    // порождённые moc-файлы и копии заголовков, и настоящий результат тонет.
    "search.exclude": {
        "**/build": true,
        "**/build-*": true,
        "**/_deps": true
    },
    "files.watcherExclude": {
        "**/build/**": true,
        "**/build-*/**": true
    }
}
