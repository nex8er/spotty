// Ресурс значка Windows.
//
// Без него у spotty.exe нет своей иконки: Проводник и панель задач показывали бы общий
// значок исполняемого файла по умолчанию. Идентификатор ресурса — не смысловое имя, а
// то, что ищет линковщик; название файла ниже разрешается относительно каталога,
// в котором лежит сам .rc.
IDI_ICON1 ICON "spotty.ico"
