/* Таблица стилей Spotty.
 *
 * Плейсхолдеры вида @имя подставляет ThemeManager из структуры ThemeColors, поэтому одни и
 * те же значения управляют и этой таблицей, и собственной отрисовкой терминала.
 * Записывать цвет числом здесь нельзя: он немедленно разойдётся с тем, чем рисует себя
 * терминал.
 *
 * Оформление намеренно плоское и монохромное: ни градиентов, ни скруглённой обводки,
 * единственный акцентный цвет — только для фокуса и выделения. Структура выражается
 * линиями толщиной в пиксель, а не рамками.
 *
 * Список допустимых плейсхолдеров задан в ThemeManager::resolveStylesheet(); незнакомый
 * @имя вызывает предупреждение при запуске. */

QWidget {
    font-size: 13px;
}

QMainWindow,
QDialog {
    background: @window;
}

/* --- Области окна ----------------------------------------------------------------- */

/* Карточка — общий вид всех блоков окна: интерфейс, терминал, отправка.
 *
 * Правило одно на все блоки: так они заведомо выглядят одинаково, а добавление
 * четвёртого не требует нового стиля. */
#card {
    background: @panel;
    border: 1px solid @border;
    border-radius: 4px;
}

/* Полосы кнопок внутри карточек: фон свой не нужен, его даёт карточка. Отделяются
 * от содержимого только линией. */
#interfaceBar,
#sendBar {
    background: transparent;
}

#terminalToolbar {
    background: transparent;
    border-bottom: 1px solid @border;
}

/* Терминал внутри карточки собственной рамки не имеет: их было бы две вложенных. */
#terminalView {
    background: @base;
    border: none;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
}

#sidePanel {
    background: @panel;
    border-right: 1px solid @border;
}

#panelTitle {
    font-weight: 600;
    padding: 6px 8px;
}

#statusDot {
    padding: 0 4px;
}

#hintLabel {
    color: @textMuted;
}

/* --- Элементы управления ---------------------------------------------------------- */

QToolButton {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 4px;
}

QToolButton:hover {
    background: @base;
    border-color: @border;
}

QToolButton:pressed,
QToolButton:checked {
    background: @selection;
    border-color: @accent;
}

QToolButton::menu-indicator {
    image: none;
}

QPushButton {
    background: @panel;
    border: 1px solid @border;
    border-radius: 3px;
    padding: 5px 14px;
}

QPushButton:hover {
    border-color: @accent;
}

QPushButton:pressed {
    background: @selection;
}

QPushButton:disabled {
    color: @textMuted;
    border-color: @border;
}

QLineEdit,
QComboBox,
QSpinBox,
QPlainTextEdit,
QAbstractScrollArea {
    background: @base;
    border: 1px solid @border;
    border-radius: 3px;
    selection-background-color: @selection;
    selection-color: @text;
}

QLineEdit,
QSpinBox {
    padding: 4px 6px;
}

QComboBox {
    /* Своя, увеличенная справа величина, а не общая с QLineEdit/QSpinBox: без запаса под
       стрелку и явных subcontrol-origin/position у ::drop-down ниже внутренний QLineEdit
       редактируемого списка растягивается на всю ширину виджета, включая область стрелки.
       Клик по стрелке в таком случае просто ставит курсор в текст — список не открывается
       вовсе. */
    padding: 4px 22px 4px 6px;
}

QLineEdit:focus,
QComboBox:focus,
QSpinBox:focus {
    border-color: @accent;
}

/* Обязательное поле схемы плагина пусто (см. SettingsField::required). Специфичность
   селектора равна QComboBox:focus и т.п. — правило намеренно идёт после них по файлу,
   чтобы красная рамка не пропадала, пока пользователь стоит в самом этом поле. */
QWidget[fieldInvalid="true"] {
    border: 1px solid @errorText;
}

/* Никакого ::drop-down здесь намеренно: любое собственное правило для этого подэлемента —
   хоть просто border/width — заставляет QStyleSheetStyle перестать рисовать родную стрелку
   Fusion вовсе, и на тёмной теме кнопка выпадения становится незрячей чёрным по чёрному.
   Резерва места в padding-right у QComboBox выше достаточно, чтобы клик по этой области не
   попадал в текстовое поле — родная отрисовка и раскладка кнопки остаются на Fusion. */

QComboBox QAbstractItemView {
    background: @base;
    border: 1px solid @border;
    selection-background-color: @selection;
    outline: none;
}

/* --- Списки и меню ---------------------------------------------------------------- */

QListView,
QTreeView,
QTableView {
    background: @base;
    border: 1px solid @border;
    outline: none;
}

QListView::item,
QTreeView::item,
QTableView::item {
    padding: 4px 6px;
    border: none;
}

QListView::item:selected,
QTreeView::item:selected,
QTableView::item:selected {
    background: @selection;
    color: @text;
}

QMenuBar {
    background: @panel;
    border-bottom: 1px solid @border;
}

QMenuBar::item {
    padding: 5px 10px;
    background: transparent;
}

QMenuBar::item:selected {
    background: @selection;
}

QMenu {
    background: @panel;
    border: 1px solid @border;
    padding: 4px 0;
}

QMenu::item {
    padding: 5px 22px;
}

QMenu::item:selected {
    background: @selection;
}

QMenu::separator {
    height: 1px;
    background: @border;
    margin: 4px 8px;
}

/* --- Полосы прокрутки: тонкие, без стрелок и оформления дорожки -------------------- */

QScrollBar:vertical {
    background: @base;
    width: 10px;
    margin: 0;
}

QScrollBar:horizontal {
    background:  @base;
    height: 10px;
    margin: 0;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: @border;
    border-radius: 5px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:hover {
    background: @textMuted;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    border: none;
    height: 0;
    width: 0;
}

/* --- Разделители ------------------------------------------------------------------ */

QSplitter::handle {
    background: @border;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QStatusBar {
    background: @panel;
    border-top: 1px solid @border;
    color: @textMuted;
}

QStatusBar::item {
    border: none;
}

QToolTip {
    background: @panel;
    color: @text;
    border: 1px solid @border;
    padding: 4px 6px;
}

QGroupBox {
    border: 1px solid @border;
    border-radius: 3px;
    margin-top: 10px;
    padding-top: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
    color: @textMuted;
}
